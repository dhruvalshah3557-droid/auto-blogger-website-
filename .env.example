# Admin credentials (for uploading to colourdiam.com)
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Admin panel URLs
ADMIN_LOGIN_URL=https://www.colourdiam.com/adminlogin
ADMIN_DASHBOARD_URL=https://www.colourdiam.com/Admin/Dashboard
ADMIN_BLOG_URL=https://www.colourdiam.com/Admin/Blog

# Content mode: "llm" (generate via LLM) or "rss" (fetch from RSS feed)
CONTENT_MODE=llm

# RSS feed URL (only needed for CONTENT_MODE=rss)
RSS_FEED_URL=

# LLM API configuration - use your OWN free-tier key from a legitimate provider
# (e.g. Google AI Studio: https://aistudio.google.com, Groq: https://console.groq.com,
#  OpenRouter free models, NVIDIA NIM, Mistral, Cerebras - see free-llm-api-resources list)
USER_LLM_BASE_URL=https://api.openai.com/v1
USER_LLM_API_KEY=
USER_LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.7

# How many articles to generate per run
ARTICLES_PER_RUN=1

# Comma-separated topic pool (leave empty to use the built-in default pool)
TOPIC_POOL=

# Set to "true" to auto-upload generated articles to colourdiam.com
# Set to "false" to only generate and save articles for review
AUTO_UPLOAD=false

# Upload schedule (cron format): default is every hour
UPLOAD_SCHEDULE=0 * * * *

# Set to "true" to run once and exit (for testing)
RUN_ONCE=false
